# syntax=docker/dockerfile:1.6
ARG BASE_TAG=dev
FROM paperclipai/agent-runtime-base:${BASE_TAG}

USER root
# opencode-ai npm package; binary on PATH is `opencode`.
RUN export HOME=/root \
      NPM_CONFIG_CACHE=/root/.npm \
      XDG_CACHE_HOME=/root/.cache \
      XDG_CONFIG_HOME=/root/.config \
      XDG_DATA_HOME=/root/.local/share \
      XDG_STATE_HOME=/root/.local/state \
    && npm install -g --no-audit --no-fund opencode-ai@latest \
    && OPENCODE_ROOT="$(npm root -g)/opencode-ai" \
    && chown -R 0:0 "$OPENCODE_ROOT" \
    && chmod -R go-w "$OPENCODE_ROOT"

USER 1000:1000

RUN OPENCODE_ROOT="$(npm root -g)/opencode-ai" \
    && command -v opencode >/dev/null 2>&1 \
    && test "$(stat -c '%u:%g' "$OPENCODE_ROOT")" = "0:0" \
    && test ! -w "$OPENCODE_ROOT"
