# syntax=docker/dockerfile:1.6
ARG BASE_TAG=dev
FROM paperclipai/agent-runtime-base:${BASE_TAG}

USER root
RUN export HOME=/root \
      NPM_CONFIG_CACHE=/root/.npm \
      XDG_CACHE_HOME=/root/.cache \
      XDG_CONFIG_HOME=/root/.config \
      XDG_DATA_HOME=/root/.local/share \
      XDG_STATE_HOME=/root/.local/state \
    && npm install -g --no-audit --no-fund @anthropic-ai/claude-code@latest \
    && CLAUDE_ROOT="$(npm root -g)/@anthropic-ai/claude-code" \
    && chown -R 0:0 "$CLAUDE_ROOT" \
    && chmod -R go-w "$CLAUDE_ROOT"

# @anthropic-ai/claude-code installs as 'claude'; keep a root-owned
# 'claude-code' compatibility alias for callers that use the package name.
RUN CLAUDE_BIN="$(command -v claude)" \
    && ln -s "$CLAUDE_BIN" /usr/local/bin/claude-code

USER 1000:1000

RUN CLAUDE_ROOT="$(npm root -g)/@anthropic-ai/claude-code" \
    && command -v claude-code >/dev/null 2>&1 \
    && test "$(stat -c '%u:%g' "$CLAUDE_ROOT")" = "0:0" \
    && test ! -w "$CLAUDE_ROOT"
